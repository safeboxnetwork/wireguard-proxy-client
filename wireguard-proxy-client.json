{
	"main": {
		"SERVICE_NAME": "wireguard-client",
		"DOMAIN": "null" 
	},
	"networks": [
		{
			"NAME": "wireguard-proxy-client",
			"DRIVER": "bridge",
			"SUBNET": "172.16.0.0/24",	
			"RANGE": "172.16.0.0/24",
			"GATEWAY": "172.16.0.1"
		}
	],
	"containers": [
		{ 
			"IMAGE": "registry.format.hu/wireguard-server",
			"NAME": "wireguard_proxy_client-edeg3e98",
