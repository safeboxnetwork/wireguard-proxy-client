{
	"main": {
		"SERVICE_NAME": "firewalls",
		"DOMAIN": "null" 
	},
	"containers": [
		{ 
			"IMAGE": "registry.format.hu/firewall",
			"UPDATE": "true",
			"NAME": "firewall",
			"MEMORY": "64M",
			"NETWORK": "host",
			"SCALE": "0",
			"VOLUMES": [
				{
				"SOURCE": "/run/",
				"DEST": "/run/",
				"TYPE": "rw"
				},
				{
				"SOURCE": "/etc/user/config/services",
				"DEST": "/services",
				"TYPE": "ro"
				},
				{
                                "SOURCE": "/etc/system/data/dns/hosts.local", 
                                "DEST": "/etc/dns/hosts.local",
                                "TYPE": "ro"
                                },
				{
                                 "SOURCE": "/var/run/docker.sock",
                                 "DEST": "/var/run/docker.sock",
                                 "TYPE": "rw"
                                 },
                                 {
                                 "SOURCE": "/usr/bin/docker",
                                 "DEST": "/usr/bin/docker",
                                 "TYPE": "ro"
                                 }
				],
			"PORTS": [ ],
			"READYNESS": [
			        {"tcp": ""},
			        {"HTTP": ""},
				{"EXEC": "/ready.sh"}
				],
                        "ENVS": [ 
               			{ "CHAIN": "DOCKER-USER" },
                                { "SOURCE": "proxyvpnclient" },
                                { "TARGET": "smarthostloadbalancer" },
                                { "TYPE": "tcp" },
                                { "TARGET_PORT_1": "80" },
                                { "TARGET_PORT_2": "443" },
                                { "COMMENT": "vpn access smarthost loadbalancer" }
                                ], 
			"EXTRA": "--privileged --rm",
			"DEPEND": "null",
			"START_ON_BOOT": "false",
			"CMD": "null",
			"PRE_START": "null",
			"POST_START": "null"
		}
	]
}
